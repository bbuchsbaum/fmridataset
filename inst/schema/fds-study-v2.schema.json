{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org.fmridataset.fds-study/v2",
  "title": "FDS study logical manifest version 2",
  "type": "object",
  "required": [
    "schema",
    "object_type",
    "representations",
    "arrays",
    "entities",
    "links",
    "tables",
    "metadata",
    "provenance",
    "extensions"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "org.fmridataset.fds-study/v2"},
        "version": {"const": 2}
      },
      "additionalProperties": false
    },
    "object_type": {"const": "fmri_study"},
    "representations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/representation"}
    },
    "arrays": {
      "anyOf": [
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/array"}},
        {"type": "array", "maxItems": 0}
      ]
    },
    "entities": {"$ref": "#/$defs/record"},
    "links": {
      "anyOf": [
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/link"}},
        {"type": "array", "maxItems": 0}
      ]
    },
    "tables": {"$ref": "#/$defs/record"},
    "metadata": {"$ref": "#/$defs/record"},
    "provenance": {},
    "extensions": {"$ref": "#/$defs/record"}
  },
  "$defs": {
    "record": {
      "description": "A named record or registry. jsonlite serializes an empty R list as [], so an empty array is accepted as the empty record.",
      "anyOf": [
        {"type": "object"},
        {"type": "array", "maxItems": 0}
      ]
    },
    "array": {
      "type": "object",
      "required": ["key", "axes", "shape", "dtype"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "axes": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "shape": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "integer", "minimum": 0}
        },
        "dtype": {"enum": ["logical", "uint8", "int8", "uint16", "int16", "float16", "bfloat16", "uint32", "int32", "float32", "uint64", "int64", "float64", "complex64", "complex128"]}
      }
    },
    "link": {
      "type": "object",
      "required": [
        "source", "target", "type", "map", "source_axis", "target_axis",
        "operator", "metadata", "schema_version"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["derivation", "mapping", "correspondence", "alignment"]
        },
        "map": {
          "description": "null, or the row records of a .source_id/.target_id map.",
          "type": ["array", "object", "null"]
        },
        "source_axis": {"enum": ["observation", "feature"]},
        "target_axis": {"enum": ["observation", "feature"]},
        "operator": {
          "description": "null, or a typed feature-map operator for feature mappings and alignments.",
          "type": ["object", "null"]
        },
        "metadata": {"$ref": "#/$defs/record"},
        "schema_version": {"const": 2}
      },
      "additionalProperties": false
    },
    "representation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "manifest"],
          "properties": {
            "type": {"const": "fmri_frame"},
            "manifest": {"type": "object"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "members", "metadata", "provenance"],
          "properties": {
            "type": {"const": "fmri_collection"},
            "members": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "object"}
            },
            "metadata": {"$ref": "#/$defs/record"},
            "provenance": {}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
