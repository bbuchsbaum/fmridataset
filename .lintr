linters:
  # namespace_linter treats deliberate qualified calls as style findings;
  # R CMD check remains the gate for undeclared package usage.
  linters_with_tags("correctness")[c(
    "duplicate_argument_linter",
    "equals_na_linter",
    "missing_argument_linter",
    "package_hooks_linter",
    "sprintf_linter"
  )]
exclusions: list(
    "tests/testthat.R",
    "data-raw",
    "inst/doc"
  )
