linters: linters_with_defaults(
    line_length_linter(120),
    object_length_linter(40),
    cyclocomp_linter(15),
    # object_name_linter disabled: the package uses deliberate domain
    # abbreviations (TR), cross-ecosystem conventions (rowData, nextEl),
    # and mixed exported generics (get_TR, as.matrix_dataset) that no single
    # naming style can model. Renaming would break the public API.
    object_name_linter = NULL,
    assignment_linter = NULL,
    pipe_continuation_linter = NULL
  )
exclusions: list(
    "tests/testthat.R",
    "data-raw",
    "inst/doc",
    # Test code legitimately references testthat globals and uses <<- mock
    # counters; vignette chunks use illustrative `...` pseudo-code bodies.
    "tests" = list(object_usage_linter = Inf, object_length_linter = Inf),
    "vignettes" = list(object_usage_linter = Inf)
  )
